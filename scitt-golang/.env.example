# SCITT Transparency Service Configuration
# Copy this file to .env and update with your actual values
# The .env file is gitignored and should never be committed

# IMPORTANT: Quote values containing special characters (&, ?, %, $, etc.)
# This ensures the .env file can be sourced correctly with: source .env
# Example: VARIABLE="value with & or ? chars"

# Service API Key
# Generate with: openssl rand -hex 32
# Reference this in YAML as: server.api_key: ${SCITT_API_KEY}
SCITT_API_KEY=your-generated-api-key-here

# MongoDB Connection (for transparency service)
# Used when database.type is "mongodb" in service configuration
# Reference this in YAML as: mongodb.uri: ${SCITT_MONGODB_URI}
# IMPORTANT: Always quote MongoDB URIs as they contain special characters
SCITT_MONGODB_URI="mongodb://username:password@localhost:27017"
SCITT_MONGODB_DATABASE=scitt_production

# Alternative MongoDB connection strings (always use quotes):
# Local dev (no auth):      SCITT_MONGODB_URI="mongodb://localhost:27017"
# MongoDB Atlas:            SCITT_MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?param=value"
# Azure Cosmos DB:          SCITT_MONGODB_URI="mongodb+srv://user:pass@host/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false"
# Docker Compose:           SCITT_MONGODB_URI="mongodb://scitt:password@mongodb:27017"

# Tile Storage
# Azure SAS URL (quote required due to query parameters with & and %)
# Reference this in YAML as: storage.azure.sas_url: ${SCITT_AZURE_BLOB_SAS_URL}
SCITT_AZURE_BLOB_SAS_URL="https://account.blob.core.windows.net/container?sas_params"
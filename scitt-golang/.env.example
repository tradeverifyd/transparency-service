# MongoDB Connection String
# Local MongoDB (for testing with Docker)
MONGODB_URI=mongodb://scitt_test:scitt_test_password@localhost:27017

# MongoDB Database Name
MONGODB_DATABASE=scitt_test

# Alternative connection strings:
# For MongoDB without auth: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net
# For Azure Cosmos DB: mongodb+srv://username:password@host/?tls=true&authMechanism=SCRAM-SHA-256
